{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext", "moduleResolution": "NodeNext", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "allowImportingTsExtensions": true, "noEmit": true,
    "types": ["node"]
  },
  "include": ["web", "server", "shared", "tests", "vite.config.ts", "playwright.config.ts"]
}
