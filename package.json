{
  "name": "sitefenn",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts --dev",
    "start": "node dist/server/index.js",
    "build": "vite build && tsc -p tsconfig.server.json",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "browser:install": "playwright install chromium",
    "restore": "tsx scripts/restore-backup.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "test:readiness": "tsx scripts/readiness.ts",
    "test:ai-local": "tsx scripts/ai-identity-smoke.ts",
    "test:page-ai-local": "tsx scripts/page-ai-smoke.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.8",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/archivo-black": "5.3.0",
    "axe-core": "4.14.0",
    "fastify": "5.12.7",
    "fflate": "0.8.3",
    "lighthouse": "13.6.0",
    "lucide-react": "1.63.0",
    "parse5": "8.0.0",
    "playwright": "1.64.1",
    "pngjs": "^7.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "robots-parser": "3.0.1",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
